{
  "name": "todolist-frontend",
  "version": "1.0.0",
  "description": "ToDoList Frontend with React",
  "homepage": "/apps/task-manager",
  "private": true,
  "dependencies": {
    "axios": "^1.6.0",
    "d3": "^7.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "set PORT=3001 && react-scripts start",
    "build": "set PORT=3001 && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
