      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:3000",
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "env-cmd": "^11.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  }
}
